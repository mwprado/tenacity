{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build tenacity-gnome-prototype",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-gnome-prototype",
        "--target",
        "tenacity-gnome-prototype",
        "-j8"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run tenacity-gnome-prototype",
      "type": "shell",
      "command": "${workspaceFolder}/build-gnome-prototype/tenacity-gnome-prototype",
      "dependsOn": "Build tenacity-gnome-prototype",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Git add commit push",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/gcp.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}